{
  "name": "monarchy",
  "version": "1.0.4",
  "description": "Monarchy — TTRPG character companion & table",
  "main": "electron/main.js",
  "private": true,
  "scripts": {
    "build:html": "node build.js",
    "start": "npm run build:html && electron .",
    "dist": "npm run build:html && electron-builder",
    "release": "npm run build:html && electron-builder --win --publish always",
    "hooks": "git config core.hooksPath .githooks",
    "test": "node build.js && node test/tincture.test.js && node test/session.test.js && node test/blazon.test.js && node test/smooth.test.js && node test/geometry.test.js && node test/table.test.js && node test/table-ui.test.js && node test/join.test.js && node test/handling.test.js && node test/herald.test.js && node test/case.test.js",
    "test:ui": "node build.js && node test/table-ui.test.js"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^24.1.3",
    "playwright": "^1.49.0"
  },
  "build": {
    "appId": "com.grumkata.monarchy",
    "productName": "Monarchy",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    },
    "mac": {
      "target": [
        "dmg"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "grumkata",
      "repo": "monarchyCompainionApp",
      "releaseType": "release"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "firebase": "^12.19.0"
  }
}
